{
  "name": "state-launcher",
  "version": "0.2.2",
  "license": "MIT",
  "author": "Alec Larson",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleclarson/state-launcher.git"
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./preact": {
      "types": "./dist/preact.d.mts",
      "default": "./dist/preact.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --sourcemap --watch",
    "build": "tsdown",
    "format": "oxfmt .",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "test": "vitest",
    "demo": "vite examples --host 127.0.0.1",
    "playground": "vite playground --host 127.0.0.1",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@goddard-ai/ui-primitives": "^0.1.2",
    "@preact/signals": "^2.9.1",
    "fuzzysort2": "^0.1.1",
    "isolet-js": "^0.0.7"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.2",
    "@types/node": "^25.9.1",
    "happy-dom": "^20.10.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "preact": "^10.29.2",
    "radashi": "^12.9.1",
    "tsdown": "^0.22.2",
    "tsnapi": "^0.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "preact": "*"
  },
  "packageManager": "pnpm@11.5.1"
}
