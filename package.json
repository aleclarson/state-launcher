{
  "name": "state-launcher",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Alec Larson",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleclarson/state-launcher.git"
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./preact": {
      "types": "./dist/preact.d.mts",
      "default": "./dist/preact.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --sourcemap --watch",
    "build": "tsdown",
    "format": "oxfmt .",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "test": "vitest",
    "demo": "vite examples --host 127.0.0.1",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@preact/signals": "^2.9.1",
    "fuzzysort2": "^0.1.1",
    "isolet-js": "^0.0.7",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@types/node": "*",
    "happy-dom": "^20.10.2",
    "oxfmt": "*",
    "oxlint": "*",
    "radashi": "*",
    "tsdown": "*",
    "tsnapi": "^0.1.1",
    "typescript": "*",
    "vite": "^8.0.16",
    "vitest": "*"
  }
}
